PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/your-db-name?appName=Cluster0

MONGODB_URI_DIRECT=mongodb://<host>:<port>/<database-name>
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET_KEY_HERE
NODE_ENV=development

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:4173,https://your-frontend-domain.example
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,https://your-frontend-domain.example

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Background EPUB Parsing Concurrency (Default: 2)
EPUB_PARSE_CONCURRENCY=2



